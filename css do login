* {
  box-sizing: border-box;
}

body {
  width: 100%;
  height: 100%;
}

form {
  width: 300px;
  margin: 200px auto;
  text-align: center;
}

input {
  display: block;
  margin: 10px auto;
  width: 250px;
  height: 30px;
  border: 1px solid white;
}

body {
  background-image: url(img/prado.JPG);
  background-size: cover;
  background-repeat: no-repeat;
  background-attachment: fixed;
  background-position: center;
  overflow-x: hidden;
}
@media all and (max-width: 1000px) {
  input {
    position: relative;
    margin-left: 50%;
    transform: translate(-50%, 0%);
  }
}
